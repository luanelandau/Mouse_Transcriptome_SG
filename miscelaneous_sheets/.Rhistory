library(scales)
# ============================================================
# Read mouse data
# ============================================================
mouse_par <- read.csv("tpm/mouse_PAR_TPM_mastersheet.csv")
mouse_sm <- read.csv("tpm/mouse_SM_TPM_mastersheet.csv")
mouse_sl <- read.csv("tpm/mouse_SL_TPM_mastersheet.csv")
mouse_panc <- read.csv("tpm/mouse_PANC_TPM_mastersheet.csv")
mouse_liv <- read.csv("tpm/mouse_LIV_TPM_mastersheet.csv")
# ============================================================
# Filter expressed genes
# ============================================================
filter_expressed <- function(data) {
data %>%
filter(
!is.na(mean_tpm),
is.finite(mean_tpm),
mean_tpm > 0
)
}
# ============================================================
# Prepare plotting data
# ============================================================
prepare_data <- function(data, gland, species) {
data %>%
filter_expressed() %>%
mutate(
Gland = gland,
Species = species
)
}
mouse_df <- bind_rows(
prepare_data(mouse_par,  "PAR",  "Mouse"),
prepare_data(mouse_sm,   "SM",   "Mouse"),
prepare_data(mouse_sl,   "SL",   "Mouse"),
prepare_data(mouse_panc, "PANC", "Mouse"),
prepare_data(mouse_liv,  "LIV",  "Mouse")
)
mouse_df$Gland <- factor(mouse_df$Gland, levels = c("PAR", "SM", "SL", "PANC", "LIV"))
# ============================================================
# Function to calculate expression statistics
# ============================================================
calculate_expression_stats <- function(data) {
ranked_data <- data %>%
arrange(desc(mean_tpm)) %>%
mutate(
cumulative_TPM = cumsum(mean_tpm),
cumulative_fraction = cumulative_TPM / sum(mean_tpm)
)
total_expressed <- nrow(ranked_data)
genes_for_50_percent <- which(ranked_data$cumulative_fraction >= 0.50)[1]
percent_genes <- 100 * genes_for_50_percent / total_expressed
data.frame(
total_expressed = total_expressed,
genes_for_50_percent = genes_for_50_percent,
percent_genes = percent_genes
)
}
# ============================================================
# Build annotation table for each species
# ============================================================
make_annotation_df <- function(df) {
df %>%
group_by(Gland) %>%
group_modify(~{
stats <- calculate_expression_stats(.x)
data.frame(
x = quantile(.x$mean_tpm, 0.02, na.rm = TRUE),
label = paste0(
"Expressed genes: ", comma(stats$total_expressed),
"\nGenes producing 50% of TPM: ", comma(stats$genes_for_50_percent)
)
)
}) %>%
ungroup()
}
mouse_annot <- make_annotation_df(mouse_df)
human_annot <- make_annotation_df(human_df)
mouse_annot <- make_annotation_df(mouse_df)
gland_colors <- c(
"PAR"  = "#d87171",
"SM"   = "#f0debe",
"SL"   = "#043a5c",
"PANC" = "#4f8c85",
"LIV"  = "#700909"
)
# ============================================================
# Plot function
# This uses fixed facet scales, so x and y are shared
# within each species figure.
# ============================================================
make_species_plot <- function(df, annot_df, species_name) {
ggplot(df, aes(x = mean_tpm, fill = Gland)) +
geom_histogram(
bins = 50,
color = "black",
linewidth = 0.25
) +
geom_text(
data = annot_df,
aes(x = x, y = Inf, label = label),
inherit.aes = FALSE,
hjust = 0,
vjust = 1.1,
size = 3.1
) +
scale_fill_manual(values = gland_colors, guide = "none") +
scale_x_log10(
breaks = breaks_log(n = 5),
labels = label_number()
) +
scale_y_continuous(
expand = expansion(mult = c(0, 0.22))
) +
facet_wrap(~Gland, ncol = 3) +
coord_cartesian(clip = "off") +
theme_classic(base_size = 12) +
theme(
strip.text = element_text(face = "bold", size = 12),
plot.title = element_text(face = "bold", size = 18),
plot.subtitle = element_text(size = 11),
axis.text.x = element_text(angle = 45, hjust = 1)
) +
labs(
title = paste0("Distribution of mean TPM values in ", tolower(species_name), " tissues"),
subtitle = "Each panel shows the number of expressed genes and the number of top-expressed genes accounting for 50% of total TPM",
x = "Mean TPM (log10 scale)",
y = "Number of genes"
)
}
# ============================================================
# Make plots
# ============================================================
mouse_distribution_plot <- make_species_plot(mouse_df, mouse_annot, "Mouse")
print(mouse_distribution_plot)
# ============================================================
# Save plots
# ============================================================
ggsave("~/Library/CloudStorage/Box-Box/SalivaryGlands_LL/Mouse_Transcriptome_SG/normalization_checks/salmon_reanalysis/salmon/SALMON_mouse_TPM_distributions_by_tissue_shared_axes.png",
mouse_distribution_plot,width = 15, height = 9, dpi = 300)
