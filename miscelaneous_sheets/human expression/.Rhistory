# Custom function to read your files
importer <- function(file) {
df <- read_delim(file, delim = "\t", comment = "#")
# Ensure the first column is rownames (Gene IDs)
rownames(df) <- df$Geneid
# Return only the counts column(s) (in your case, the last column)
as.matrix(df[,ncol(df)])
}
# Apply tximport using the custom importer
txi <- tximport(files, type = "none", txOut = TRUE, countsFromAbundance = "lengthScaledTPM",
length = gene_lengths, importer = importer)
