# Step 1: Read in featureCounts output (ensure the file has the appropriate structure)
# Assuming featureCounts output is read in this way:
fc <- read.delim("/Users/istarr/Library/CloudStorage/Box-Box/Ancestral_SG/readCounts_baboon/Bab-01-LIV-Fem-FF.counts.txt", comment.char="#")
# Step 2: Extract gene lengths from the featureCounts output
# Gene lengths are typically in the 'Length' column
gene_lengths <- fc$Length
# Step 3: Extract counts
# Assuming counts are in the last column (replace with actual column index if needed)
counts <- fc[,ncol(fc)]  # This would be the counts column from featureCounts
View(fc)
counts
# Step 4: Create DGEList object with counts and gene lengths
dge <- DGEList(counts = as.matrix(counts))
# Step 5: Calculate TPM
# Use the rpk (reads per kilobase) normalization for TPM calculation
rpk <- dge$counts / gene_lengths  # reads per kilobase
scale_factor <- colSums(rpk) / 1e6  # per million scaling factor
tpm <- t(t(rpk) / scale_factor)
# Step 6: View TPMs
head(tpm)
# Step 1: List all the featureCounts files in the directory
folder_path <- "/Users/istarr/Library/CloudStorage/Box-Box/Ancestral_SG/readCounts_baboon"
files <- list.files(path = folder_path, pattern = "*.counts.txt", full.names = TRUE)
# List only files that end with .counts.txt, excluding any .summary files
files <- list.files(path = folder_path, pattern = ".*\\.counts\\.txt$", full.names = TRUE)
# List only files that end with .counts.txt, excluding any .summary files
files <- list.files(path = folder_path, pattern = ".*\\.counts\\.txt$", full.names = TRUE)
# Step 2: Function to read and extract counts and gene lengths
read_featureCounts <- function(file) {
fc <- read.delim(file, comment.char = "#")
gene_lengths <- fc$Length
counts <- fc[,ncol(fc)]  # Assuming the last column contains the counts
rownames(counts) <- fc$Geneid  # Set the gene IDs as rownames
return(list(counts = counts, gene_lengths = gene_lengths))
}
# Step 3: Import all files and store counts and gene lengths
all_counts <- list()
all_lengths <- list()
for (file in files) {
data <- read_featureCounts(file)
all_counts[[basename(file)]] <- data$counts
all_lengths[[basename(file)]] <- data$gene_lengths
}
