# Step 2: Function to read and extract counts and gene lengths
read_featureCounts <- function(file) {
# Read the featureCounts file
fc <- read.delim(file, comment.char = "#")
# Print the structure for debugging
print(paste("Reading file:", file))
print(head(fc))  # Display the first few rows
# Check if the necessary columns exist
if (!"Geneid" %in% colnames(fc)) {
stop("Column 'Geneid' not found in the file.")
}
if (!"Length" %in% colnames(fc)) {
stop("Column 'Length' not found in the file.")
}
# Extract gene lengths and counts
gene_lengths <- fc$Length
counts <- fc[, ncol(fc)]  # Access the last column for counts
# Check if counts were extracted correctly
if (length(counts) == 0) {
stop("No counts found in the last column.")
}
rownames(counts) <- fc$Geneid  # Set the gene IDs as rownames
return(list(counts = counts, gene_lengths = gene_lengths))
}
